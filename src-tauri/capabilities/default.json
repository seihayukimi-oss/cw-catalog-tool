{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CWカタログの画面に許可すること。ファイル操作の範囲は、ユーザーがダイアログで選んだフォルダと、アプリ内ブラウザが受け取ったファイルの置き場（CWCatalog-data\\downloads）だけ。範囲はアプリ側（Rust）で管理し、選んだフォルダは CWCatalog-data に覚える。アプリ内ブラウザ（dl窓）は外部のページを表示するので、権限は一切与えない。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "allow-open-download-window",
    "allow-portable-info",
    "allow-take-open-args",
    "allow-net-fetch",
    "allow-net-take",
    "allow-machine-key",
    "allow-default-store-dirs",
    "allow-open-folder",
    "allow-portable-update-install",
    "allow-update-key-configured",
    "allow-downloads-list",
    "allow-downloads-read",
    "allow-zone-info",
    "allow-assoc-status",
    "allow-assoc-register",
    "allow-assoc-unregister",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/CardWirth.exe"
        },
        {
          "path": "**/CardWirthNext.exe"
        },
        {
          "path": "**/CardWirthPy.exe"
        }
      ]
    }
  ]
}