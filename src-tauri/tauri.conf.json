{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CWCatalog",
  "version": "../package.json",
  "identifier": "io.github.cwcatalog.tool",
  "build": {
    "frontendDist": "../dist/app",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CWカタログ",
        "width": 1100,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "CWカタログ",
    "shortDescription": "CardWirth シナリオの一括DL・インストール・更新チェック",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "ここに更新用の公開鍵を入れる（README参照）",
      "endpoints": ["https://github.com/OWNER/cw-catalog-tool/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
